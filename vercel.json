{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "sentinel/**"
    }
  },
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/sentinel/frontend/$1" },
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}
